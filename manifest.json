{
  "manifest_version": 3,
  "name": "Freedom Chess for Chess.com",
  "version": "2.0.0",
  "description": "Controle o tabuleiro do Chess.com por voz, com foco em acessibilidade e privacidade.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "builtFunctions/mainWorldBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "css": [
        "styles/main.css"
      ],
      "js": [
        "builtFunctions/core.js",
        "builtFunctions/freedomChessApp.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "images/freedomChess16.png",
    "128": "images/freedomChess128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/freedomChess16.png",
      "128": "images/freedomChess128.png"
    },
    "default_title": "Alternar Freedom Chess"
  }
}
